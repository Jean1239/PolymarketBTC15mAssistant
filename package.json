{
  "name": "polyassistent",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "start:5m": "node --env-file=.env src/index5m.js",
    "start:dashboard": "node src/logServer.js",
    "report": "node scripts/report.js",
    "dashboard:dev": "cd dashboard && npm run dev",
    "dashboard:build": "cd dashboard && npm run build",
    "db:migrate": "node src/auth/migrate.js",
    "db:seed-admin": "node src/auth/seedAdmin.js",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "backfill:strategy": "node scripts/backfillStrategyHash.js",
    "smoke:strategy": "node scripts/smokeTestStrategy.js",
    "smoke:bundle": "node scripts/smokeTestAnalysisBundle.js",
    "smoke:orderbook": "node scripts/smokeTestOrderbookCapture.js",
    "smoke:pipeline": "node scripts/smokeTestPipeline.js",
    "smoke:paths": "node scripts/smokeTestPaths.js",
    "smoke:realtradelog": "node scripts/smokeTestRealTradeLog.js",
    "smoke:dryrun-disable": "node scripts/smokeTestDryRunDisable.js",
    "smoke:migration": "node scripts/smokeTestMigration.js",
    "backtest:verify": "npm run smoke:orderbook && npm run smoke:pipeline"
  },
  "dependencies": {
    "@polymarket/clob-client-v2": "^1.0.6",
    "better-auth": "^1.6.10",
    "better-sqlite3": "^12.9.0",
    "drizzle-orm": "^0.45.2",
    "ethers": "^6.11.1",
    "https-proxy-agent": "^7.0.6",
    "socks-proxy-agent": "^8.0.5",
    "undici": "^6.21.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "shadcn": "^4.5.0"
  }
}
