FROM node:22-alpine AS dashboard-builder
WORKDIR /build
COPY dashboard/package*.json ./
RUN npm ci
COPY dashboard/ ./
RUN npm run build

FROM node:22-alpine AS server-deps
WORKDIR /build
COPY package*.json ./
# better-sqlite3 is a native module; install build deps so npm ci can compile
# from source if a prebuilt binary is unavailable for this platform/abi.
RUN apk add --no-cache python3 make g++ \
 && npm ci --omit=dev

FROM node:22-alpine
WORKDIR /app

COPY --from=server-deps /build/node_modules ./node_modules
COPY package*.json ./
COPY src/logServer.js ./src/
COPY src/auth/ ./src/auth/
COPY drizzle/ ./drizzle/
COPY --from=dashboard-builder /build/dist ./dashboard/dist

RUN mkdir -p logs

# Migrations + admin seed run inside logServer.js bootstrap before listen().
CMD ["node", "--max-old-space-size=128", "src/logServer.js"]
